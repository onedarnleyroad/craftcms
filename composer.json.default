{
  "autoload": {
    "psr-4": {
      "modules\\sitemodule\\": "modules/sitemodule/src/"
    }
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "treeware/plant": false,
      "yiisoft/yii2-composer": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3"
    },
    "sort-packages": true
  },
  "require": {
    "craftcms/ckeditor": "^5.4.0",
    "craftcms/cms": "^5.9.18",
    "craftcms/postmark": "^3.1.0",
    "mmikkel/cp-field-inspect": "^2.0.4",
    "nystudio107/craft-seomatic": "^5.1.21",
    "nystudio107/craft-vite": "^5.0.1",
    "servd/craft-asset-storage": "^4.2.4.2",
    "verbb/hyper": "^2.3.3",
    "verbb/knock-knock": "^3.0.5",
    "vlucas/phpdotenv": "^5.6.3"
  },
  "require-dev": {
    "nystudio107/craft-autocomplete": "^1.12.2",
    "yiisoft/yii2-shell": "^2.0.6"
  },
  "scripts": {
    "craft-update": [
      "@pre-craft-update",
      "@post-craft-update"
    ],
    "pre-craft-update": [],
    "post-craft-update": [
      "@php craft install/check && php craft up --interactive=0 || exit 0",
      "@php craft install/check && php craft clear-caches/all --interactive=0 || exit 0",
      "@php craft install/check && php craft invalidate-tags/all --interactive=0 || return 0"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php craft setup/welcome"
    ],
    "pre-update-cmd": "@pre-craft-update",
    "pre-install-cmd": "@pre-craft-update",
    "post-update-cmd": "@post-craft-update",
    "post-install-cmd": "@post-craft-update"
  }
}
